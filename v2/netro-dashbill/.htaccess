# ==========================================================
# NETPRO CRM / BILL-DASH Enterprise Security Headers & Directives
# ==========================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes

# 2. Block direct access to sensitive configuration, database & version control files
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|.*\.sqlite|.*\.sql|.*\.db|.*\.log|.*\.bak|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. HTTP Security Headers (OWASP Defense in Depth)
<IfModule mod_headers.c>
    # Prevent clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Enable XSS protection filter
    Header always set X-XSS-Protection "1; mode=block"
    # Strict Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# 4. UTF-8 Encoding Enforcement
AddDefaultCharset UTF-8
