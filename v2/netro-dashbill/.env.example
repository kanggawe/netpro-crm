# ==========================================================
# BILL-DASH / NETPRO ISP Management - Environment Variables
# ==========================================================

# 1. Primary App Database (CRM, Billing, Finance PSAK, HR, NOC)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=billdash
DB_USER=postgres
DB_PASS=kanggawe123

# 2. Dedicated FreeRADIUS Database (Separate Server / DB Name)
# Kosongkan atau samakan dengan DB_HOST/DB_NAME jika single-database.
RADIUS_DB_DRIVER=pgsql
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=billdash
RADIUS_DB_USER=postgres
RADIUS_DB_PASS=kanggawe123

# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
